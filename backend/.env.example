# AutoML Agent — Environment Variables
# Copy this file to .env and fill in your values.
# The app works with all defaults — only change what you need.

# ── Server ─────────────────────────────────────────────────────────────────────
# Port to run the FastAPI server on.
# Cloud platforms (Render, Railway) inject this automatically.
PORT=8000

# ── Ollama (Local LLM) ─────────────────────────────────────────────────────────
# URL of the Ollama API server.
# Leave empty to disable AI features and use the rule-based fallback instead.
# Local:       http://localhost:11434
# Docker:      http://ollama:11434
# Remote VPS:  http://YOUR_VPS_IP:11434
OLLAMA_URL=http://localhost:11434

# ── Data Storage ───────────────────────────────────────────────────────────────
# Root directory for uploaded datasets, cleaned files, and trained models.
# Must be an absolute path. Defaults to backend/data/users/user_1
# DATA_DIR=/app/backend/data/users/user_1
